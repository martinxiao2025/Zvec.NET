<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Zvec.NET.EntityFrameworkCore</RootNamespace>
    <AssemblyName>Zvec.NET.EntityFrameworkCore</AssemblyName>
    <PackageId>Zvec.NET.EntityFrameworkCore</PackageId>
    <Version>0.7.0-preview.1</Version>
    <Authors>Zvec.NET contributors</Authors>
    <Description>Entity Framework Core integration for Zvec.NET: attribute-mapped entity vector sets, upsert sync, and hybrid similar-search that joins back to EF entities.</Description>
    <PackageTags>entity-framework-core;efcore;vector;embedding;search;zvec;hybrid-search</PackageTags>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/alibaba/zvec</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://zvec.org</PackageProjectUrl>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <!-- 裁剪/NativeAOT 兼容分析器：泛型参数已贯通 DynamicallyAccessedMembers 注解，
         注解缺失会在库构建期以警告暴露（EF Core 本身的 AOT 支持以 EF 版本为准）。 -->
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Zvec.NET\Zvec.NET.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
  </ItemGroup>

</Project>
